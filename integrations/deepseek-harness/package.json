{
  "name": "dsh-goose-research",
  "version": "0.1.0",
  "private": true,
  "description": "Goose Revisions and Pause Log for DeepSeek Harness",
  "license": "GPL-3.0-only",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "test.cjs"
  ],
  "scripts": {
    "test": "node --test test.cjs"
  },
  "engines": {
    "node": "^22.19 || >=24",
    "dsh": ">=0.1.0-rc.6"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness"
  ]
}
